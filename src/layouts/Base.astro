---
import '../styles.css';
const { title, description, image = '/img/kyrgyzstan.jpg', path = Astro.url.pathname, jsonld = [], nav = '', hero = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const img = new URL(image, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Trek Trails">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={img}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="apple-touch-icon" href="/img/favicon.png">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600&display=swap" rel="stylesheet">
<script is:inline>
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});
window.ttLoadGTM=function(){if(window.ttGTM)return;window.ttGTM=1;gtag('consent','update',{analytics_storage:'granted'});dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtm.js?id=GTM-KHBQZ27F';document.head.appendChild(s);var g=document.createElement('script');g.async=true;g.src='https://www.googletagmanager.com/gtag/js?id=G-VW9JZN4YZL';document.head.appendChild(g);gtag('js',new Date());gtag('config','G-VW9JZN4YZL');};
try{if(localStorage.getItem('tt-consent')==='yes')ttLoadGTM();}catch(e){}
</script>
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body class={hero ? "has-hero" : undefined}>
<header class="site">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Trek Trails, home"><img src="/img/logo.png" alt="Trek Trails" width="56" height="56"></a>
    <nav class="main" aria-label="Main">
      <a href="/" aria-current={nav === 'home' ? 'page' : undefined}>Home</a>
      <a href="/treks/" aria-current={nav === 'treks' ? 'page' : undefined}>All treks</a>
      <a href="/about/" aria-current={nav === 'about' ? 'page' : undefined}>About</a>
    </nav>
  </div>
</header>
<main id="app"><slot /></main>
<footer>
  <div class="stripe" aria-hidden="true"></div>
  <div class="wrap">
    <div>
      <a class="brand" href="/" aria-label="Trek Trails, home"><img src="/img/logo.png" alt="Trek Trails" width="112" height="112"></a>
      <p style="margin-top:12px;max-width:44ch">A personal project about the world's great multi-day walks.</p>
    </div>
    <nav aria-label="Footer"><a href="/treks/">All treks</a><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="#" data-cookies>Cookie settings</a><a class="social" href="https://www.instagram.com/trektrails_org/" target="_blank" rel="noopener" aria-label="Trek Trails on Instagram (@trektrails_org)"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/></svg><span>Instagram</span></a></nav>
  </div>
</footer>
<div class="consent" id="consent" role="dialog" aria-live="polite" aria-label="Cookies" hidden>
  <p>Can Trek Trails use analytics cookies? They tell us which pages people read, so we know what to improve. Nothing is used for advertising. <a href="/privacy/">More about privacy</a></p>
  <div class="consent-btns"><button type="button" data-consent="no">Decline</button><button type="button" data-consent="yes" class="yes">Accept</button></div>
</div>
<script is:inline>
(function(){var c=document.getElementById('consent'),v=null;try{v=localStorage.getItem('tt-consent')}catch(e){}
if(!v)c.hidden=false;
c.addEventListener('click',function(e){var b=e.target.closest('[data-consent]');if(!b)return;var a=b.getAttribute('data-consent');try{localStorage.setItem('tt-consent',a)}catch(e){}c.hidden=true;if(a==='yes')ttLoadGTM();else if(window.ttGTM){location.reload();}});
document.addEventListener('click',function(e){var l=e.target.closest('[data-cookies]');if(!l)return;e.preventDefault();c.hidden=false;});})();
</script>
<script is:inline src="/site.js"></script>
</body>
</html>
